#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
android/release-key.jks
android/key.properties

# Firebase CLI local artifacts (never contain secrets by themselves, but are
# machine-specific and should not be versioned)
firebase-debug.log
.firebase/
# Firebase Admin SDK service-account keys must NEVER be committed
*firebase-adminsdk*.json
*serviceAccountKey*.json
